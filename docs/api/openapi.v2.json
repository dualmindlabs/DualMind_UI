{
  "openapi": "3.1.0",
  "info": {
    "title": "DualMind Arena API v2",
    "version": "2.0.0",
    "description": "The Arena Worker API. JSON in and out, errors as RFC 9457 problem+json, every response carries X-Request-Id. /api/v2 changes only additively."
  },
  "servers": [
    {
      "url": "https://arena.dualmindlab.tech"
    }
  ],
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "apiVersion": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "environment": {
            "type": "string",
            "enum": [
              "production",
              "preview"
            ],
            "description": "Which binding set this host uses"
          },
          "bindings": {
            "type": "object",
            "properties": {
              "DB": {
                "type": "boolean"
              },
              "CACHE": {
                "type": "boolean"
              },
              "EVENTS": {
                "type": "boolean"
              },
              "PUBLIC_BUCKET": {
                "type": "boolean"
              }
            },
            "required": [
              "DB",
              "CACHE",
              "EVENTS",
              "PUBLIC_BUCKET"
            ],
            "description": "Which backend bindings are present for this host (names only)"
          }
        },
        "required": [
          "status",
          "apiVersion",
          "time",
          "environment",
          "bindings"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Identifier URL of the problem type"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "description": "The request path"
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          },
          "retryAfter": {
            "type": "integer"
          },
          "feature": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "requestId"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "role",
          "expiresAt"
        ]
      },
      "LeaderboardResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeaderboardItem"
            },
            "description": "Every ranked model, best first. The list is small and returned whole, so there is no nextCursor."
          },
          "meta": {
            "$ref": "#/components/schemas/LeaderboardMeta"
          }
        },
        "required": [
          "items",
          "meta"
        ]
      },
      "LeaderboardItem": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string",
            "description": "Stable model id",
            "example": "fdbfca6d-a3d2-4a70-b0ab-426024eb5cd5"
          },
          "modelName": {
            "type": "string",
            "description": "Full model name, may carry a provider prefix such as @cf/meta/",
            "example": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
          },
          "displayName": {
            "type": "string",
            "description": "Name to show",
            "example": "llama-3.3-70b-instruct-fp8-fast"
          },
          "providerName": {
            "type": "string",
            "example": "cloudflare"
          },
          "eloScore": {
            "type": "number",
            "description": "Elo rating, one decimal",
            "example": 1150
          },
          "eloRank": {
            "type": "integer",
            "minimum": 1,
            "description": "Rank by Elo; ties share a rank (1, 1, 3)",
            "example": 1
          },
          "totalWins": {
            "type": "integer",
            "minimum": 0,
            "example": 62
          },
          "totalLosses": {
            "type": "integer",
            "minimum": 0,
            "example": 27
          },
          "totalTies": {
            "type": "integer",
            "minimum": 0,
            "example": 9
          },
          "totalResponses": {
            "type": "integer",
            "minimum": 0,
            "description": "Battles the model took part in",
            "example": 96
          },
          "winRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Percent from 0 to 100 with two decimals; ties count as non-wins",
            "example": 64.58
          },
          "provisional": {
            "type": "boolean",
            "description": "True while totalResponses is below meta.provisionalBelow",
            "example": false
          }
        },
        "required": [
          "modelId",
          "modelName",
          "displayName",
          "providerName",
          "eloScore",
          "eloRank",
          "totalWins",
          "totalLosses",
          "totalTies",
          "totalResponses",
          "winRate",
          "provisional"
        ]
      },
      "LeaderboardMeta": {
        "type": "object",
        "properties": {
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the data last changed, not when it was served",
            "example": "2026-10-21T08:30:00.000Z"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "example": 53
          },
          "provisionalBelow": {
            "type": "integer",
            "minimum": 0,
            "example": 5
          },
          "source": {
            "type": "string",
            "example": "dualmind-api:model-stats"
          }
        },
        "required": [
          "generatedAt",
          "count",
          "provisionalBelow",
          "source"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v2/health": {
      "get": {
        "summary": "Health of the v2 router",
        "description": "Public and never cached. Says only that the v2 router is alive and which backend bindings this host has; it does not call the DualMind API (that is /api/health).",
        "tags": [
          "platform"
        ],
        "responses": {
          "200": {
            "description": "The router is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/me": {
      "get": {
        "summary": "What the verified token says",
        "description": "Needs `Authorization: Bearer <Supabase access token>`. Returns the claims of the verified token and nothing from a database. The cheapest auth probe.",
        "tags": [
          "platform"
        ],
        "responses": {
          "200": {
            "description": "The verified user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, expired or otherwise invalid token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "501": {
            "description": "Sign-in verification is not enabled on this deployment (not_enabled).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/leaderboard": {
      "get": {
        "summary": "The public leaderboard",
        "description": "Every ranked model with its Elo, record and win rate, served from the edge cache (HEAD works too). No sign-in. `winRate` is a percent from 0 to 100 and counts ties as non-wins. `provisional` is true while `totalResponses` is below `meta.provisionalBelow`. `meta.generatedAt` is when the data last changed, not when it was served. The list is small and returned whole, so there is no `nextCursor`. Send `If-None-Match` with the last `ETag` to get `304`. During an outage of the DualMind API the last good copy (up to 24 hours old) is served.",
        "tags": [
          "leaderboard"
        ],
        "responses": {
          "200": {
            "description": "The leaderboard.",
            "headers": {
              "ETag": {
                "description": "Strong tag from a hash of the data, like \"lb-5e0c1b7a93d24f10\".",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "public, max-age=30, stale-while-revalidate=60, stale-if-error=86400",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Status": {
                "description": "RFC 9211: hit, stale or miss.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaderboardResponse"
                }
              }
            }
          },
          "304": {
            "description": "The `If-None-Match` tag matches; no body."
          },
          "429": {
            "description": "Rate limit hit (rate_limited).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "The DualMind API is unreachable or invalid and no copy is stored (bad_gateway).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "504": {
            "description": "The DualMind API did not answer in time and no copy is stored (gateway_timeout).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
