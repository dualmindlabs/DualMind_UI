{
  "name": "dualmind-ui",
  "version": "1.0.0",
  "description": "DualMind Arena - AI Model Battle & LLM Leaderboard Platform",
  "main": "index.html",
  "scripts": {
    "dev": "npx serve . -p 8000",
    "start": "npm run dev",
    "lint": "eslint *.js **/*.js --ignore-pattern node_modules --ignore-pattern old-html-backup --ignore-pattern mock-api-server.js --ignore-pattern \"admin-email-system/**\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "playwright test",
    "test:ui-bugs": "playwright test tests/ui-config-bugs.spec.js",
    "validate": "npm run lint && npm run test",
    "build": "node build.js",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/dualmind-ui.git"
  },
  "keywords": [
    "ai",
    "llm",
    "arena",
    "chat",
    "comparison",
    "leaderboard"
  ],
  "author": "DualMind Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^8.57.1",
    "http-server": "^14.1.1",
    "serve": "^14.2.6"
  }
}
