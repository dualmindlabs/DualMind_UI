{
  "name": "dualmind-arena",
  "main": "worker.js",
  "compatibility_date": "2024-12-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "arena.dualmindlab.tech/*",
      "zone_name": "dualmindlab.tech"
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Every request runs worker.js first, so the pre-launch redirect (FORCE_WAITLIST in
    // worker.js) also covers paths that match a static file, such as / and /leaderboard/.
    "run_worker_first": true
  },
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "1b260a52-d2dd-4116-a42e-43c9e71fe717"
    }
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}