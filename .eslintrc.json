{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undef": "warn",
    "semi": ["error", "always"],
    "quotes": ["error", "single", { "avoidEscape": true }],
    "no-constant-condition": "warn"
  },
  "globals": {
    "AOS": "readonly",
    "Razorpay": "readonly",
    "DualMindAuth": "readonly",
    "DUALMIND_CONFIG": "readonly",
    "supabase": "readonly",
    "window": "readonly",
    "document": "readonly",
    "console": "readonly",
    "fetch": "readonly",
    "setTimeout": "readonly",
    "clearTimeout": "readonly",
    "setInterval": "readonly",
    "clearInterval": "readonly",
    "localStorage": "readonly",
    "sessionStorage": "readonly",
    "location": "readonly",
    "navigator": "readonly",
    "require": "readonly"
  }
}

