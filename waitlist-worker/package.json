{
  "name": "dualmind-waitlist",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "DualMind Arena waitlist page (early.dualmindlab.tech): a Vite + React app served by the dualmind-waitlist Cloudflare Worker",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --pretty",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "motion": "14.3.0",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  },
  "overrides": {
    "playwright-core": "1.61.1"
  }
}
