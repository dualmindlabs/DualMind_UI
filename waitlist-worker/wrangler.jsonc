{
  "name": "dualmind-waitlist",
  "main": "worker.js",
  "compatibility_date": "2024-12-01",
  // The page is a Vite + React app. `npx wrangler deploy` (run from this folder, as before)
  // installs its dependencies and builds it into dist/ first, then uploads dist/ as the assets.
  "build": {
    "command": "npm ci --no-audit --no-fund && npm run build"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  // Waitlist signups (POST /api/signup, server/signup.js). Schema: migrations/; the deploy
  // workflow (.github/workflows/deploy-waitlist.yml) applies new migrations before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dualmind-waitlist",
      "database_id": "729bf3b6-8c71-46ab-b788-9ec51a4ae57a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
