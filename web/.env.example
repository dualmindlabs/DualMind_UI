# Copy to .env.local (git-ignored) to override. Public values only: everything with the VITE_
# prefix ends up in the browser bundle. See src/config/env.ts.
VITE_SITE_URL=https://arena.dualmindlab.tech

# API calls go to same-origin /api/* (proxied by worker.js) unless this is set, e.g. to
# http://localhost:5079 for a local API. See src/config/api.ts.
VITE_API_BASE_URL=
# 1 = answer every API call from the in-memory mock adapter (demo/offline mode, e2e tests).
VITE_API_MOCK=0

# Supabase (sign-in). Public values, but never committed: production and previews read them from
# the Workers Builds build variables, CI uses dummy values. Without them the sign-in pages show a
# "sign-in unavailable" notice. Never a service-role or secret key. See src/config/supabase.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
