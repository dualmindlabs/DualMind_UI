{
  "include": ["src/**/*", "tests/**/*", "../contract/**/*.ts", ".react-router/types/**/*", "*.ts"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@contract/*": ["../contract/*"],
      "hono": ["./node_modules/hono"],
      "hono/body-limit": ["./node_modules/hono/dist/types/middleware/body-limit/index.d.ts"],
      "hono/factory": ["./node_modules/hono/dist/types/helper/factory/index.d.ts"],
      "hono/http-exception": ["./node_modules/hono/dist/types/http-exception.d.ts"],
      "@hono/*": ["./node_modules/@hono/*"],
      "jose": ["./node_modules/jose"],
      "zod": ["./node_modules/zod"]
    },
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
